  prop blurHash: string
  /// a ThumbHash (base64) shown until source loads: it keeps its image's aspect ratio and alpha
  prop thumbHash: string
  /// how the placeholder fills the box: as the image does, or its own way
  prop placeholderMode: PlaceholderMode
  /// plays an animated image (GIF, APNG, WebP) while true, stops it where it is while false; none: it plays unless the user asked for less motion (Reduce Motion), when it shows its first frame
  prop animated: bool?
  event loaded(width: float, height: float)
  event error(message: string)
}

/// scrolls its children along one axis (horizontal: a row); its wrap, justify, align, gap and padding lay out its content. Give it a size (or grow) to scroll within
native component Scroll() {
  prop children: View? = none
  prop horizontal: bool
  /// shows the pull to refresh spinner while true (with on refresh)
  prop refreshing: bool
  /// it stops only at multiples of its own size, a page each, and hides its scroll bars
  prop paging: bool
  /// the page it shows (paging): a swipe that settles writes it, and writing it scrolls there
  prop page: int
  /// its content offset as it scrolls
  event scroll(x: float, y: float)
  /// pulled to refresh
  event refresh
  /// a paging swipe is settling on a page: its index from the content's start (its leading edge, right to left)
  event pageChange(page: int)
}

/// a for in it is the platform's recycling list: rows exist only while they're on screen. It grows into its room unless it's sized
native component List() {
  prop children: View? = none
  /// shows the pull to refresh spinner while true (with on refresh)
  prop refreshing: bool
  /// a grid of this many columns (gap apart)
  prop columns: int
  prop appearance: ListAppearance
  /// .bottom: a chat's, which rests at its end
  prop anchor: ScrollAnchor
  /// row index's actions, revealed by swiping it from its trailing edge (a destructive one red; the first a full swipe's)
  prop swipeActions: fn(int) -> [Action]
  /// row index's actions revealed from its leading edge (Mail's Unread)
  prop leadingSwipeActions: fn(int) -> [Action]
  /// row index's section: rows next to each other with the same key are one, headed by header
  prop section: fn(int) -> string
  /// a section's header, given its key (an accessor: a recycled header follows its new section)
  prop header: fn(string) -> View
  /// selection mode (Mail's Edit): rows show the platform's selection control, a tap selects instead of pressing, and rows don't swipe
  prop selecting: bool
  /// whether row index is selected, followed as what it reads changes
  prop selected: fn(int) -> bool
  event scroll(x: float, y: float)
  /// pulled to refresh
  event refresh
  /// the last rows are about to show: load more (once per length)
  event endReached
  /// the first rows are about to show: load earlier ones (once per first item)
  event startReached
  /// the user selected or deselected row index; what selected doesn't take back goes back as it was
  event select(index: int, selected: bool)
  /// the user started selecting at row index while the list isn't selecting (a two-finger pan on iOS, a long press on Android)
  event selectBegin(index: int)
  /// a swipe action of row index was chosen: its index among swipeActions, or -1 - its index among leadingSwipeActions (its run has run)
  event action(index: int, action: int)
}

/// styled paragraphs (spans), typeset and drawn by the platform's text engine; the style's font, color, textAlign and lines are its spans' defaults. Each paragraph's layout is cached by its content and width
native component RichText(text: [Span]) {
  /// a span with a link tapped
  event link(url: string)
}

/// makes the RichTexts inside it selectable as one text, across them: a long press selects a word, the handles extend it over any of them, the edit menu copies it
native component Selectable() {
  prop children: View? = none
}

/// draws what draw draws: a chart, a gauge, a signature. It takes the size its style gives it; with none, it's empty
native component Canvas(draw: fn(Graphics)) {}

/// an outline, filled, stroked or both. It takes the size its style gives it
native component Shape(path: fn(float, float) -> Path) {
  prop fill: Color
  prop stroke: Color
  prop lineWidth: float = 1
  prop lineCap: LineCap
  prop lineJoin: LineJoin
  /// the part of the outline drawn, from trimStart to trimEnd (0 to 1): a progress ring; it animates in animate { }
  prop trimStart: float = 0
  prop trimEnd: float = 1
  /// lengths drawn and skipped in turn; []: solid
  prop dash: [float]
  prop dashPhase: float
}

/// a box a GPU program draws, under its children, over its background
native component Shader(program: bytes) {
  prop children: View? = none
  /// its uniform variables' values, by name; a change draws it again
  prop uniforms: [Uniform]
  /// runs its Time: drawn again every frame the display draws
  prop animated: bool
}

/// a video in the platform's player; sized as an Image is. Drive it with play(), pause(), seek(seconds)
native component Video(source: string) {
  /// .fit (letterboxed) or .fill (cropped)
  prop mode: ImageMode
  prop hideControls: bool
  prop autoPlay: bool
  prop loop: bool
  prop muted: bool
  /// played to its end (each time, looping)
  event end
  event error(message: string)
}

/// a web page, in the platform's web view; with no height and no grow, it grows
native component WebView(url: string = "") {
  /// markup to show instead
  prop html: string
  /// a script run before each page's own, in every frame (set when it's made)
  prop preload: string
  prop userAgent: string
  /// requests kept from loading: a host (and its subdomains), or with a /, a part of the URL (set when it's made)
  prop block: [string]
  /// a page loaded
  event loaded(url: string)
  event error(message: string)
  /// what the page posts: window.asuka.postMessage(text)
  event message(message: string)
  event state(state: WebState)
  /// each request the page makes (Android)
  event request(url: string)
  event download(download: WebDownload)
  /// a page it would open in a new window; without a handler it loads here
  event newWindow(url: string)
}

/// a navigation stack (UINavigationController; a view stack with a top app bar and predictive back on Android): its child is its first screen; push(…) and pop() in it add and remove more, and the user's back pops. It grows into its room unless it's sized
native component Stack() {
  prop children: View? = none
}

/// a screen of a Stack (a screen declaration's root), sized by the platform
native component Screen() {
  prop children: View? = none
  /// the bar's title (a tab's, a page's in a browser)
  prop title: string
  /// the title large at the top, collapsing into the bar as it scrolls (iOS)
  prop largeTitle: bool
  /// the edge swipe pops it (iOS)
  prop backGesture: bool = true
  /// the shared key of a view on the screen below: the screen zooms out of it as it's pushed, and back as it's popped (iOS 18)
  prop zoomFrom: string
  /// the top app bar's color while it's on top (Android)
  prop barColor: Color
  /// a search field in the bar: what's typed (typing writes it)
  prop search: string
  /// the search field's placeholder ("": Search, in the app's language)
  prop searchPlaceholder: string
  /// the search field stays out of the way until it's asked for
  prop searchButton: bool
  /// primary's title beside its icon, shrinking to the icon as the content scrolls (Android's extended FAB)
  prop primaryExtended: bool
  /// the search field's text changed
  event searchChange(text: string)
  /// return pressed in the search field
  event searchSubmit
  /// the bar's buttons: Buttons (title or icon, menu, disabled), shown by the platform's bar (iOS's navigation bar, Android's top app bar)
  prop toolbar: View? = none
  /// buttons in a bar at the bottom of the screen: Buttons, as toolbar's
  prop bottomToolbar: View? = none
  /// the screen's main action (compose, add): a Button; Android's floating action button, iOS's prominent toolbar item
  prop primary: View? = none
}

/// pages with a tab bar (UITabBarController; Material's navigation bar): its children are Tabs. It grows into its room unless it's sized
native component Tabs() {
  prop children: View? = none
  /// the shown tab's index: the user's choice writes it
  prop selected: int
  event change(index: int)
}

/// a page of Tabs: its content is built when it's first chosen
native component Tab(title: string) {
  prop children: View? = none
  /// a symbol
  prop icon: string
  /// shown on the tab: a count ("3"), or short text; empty: none
  prop badge: string
}

/// content in a modal sheet while open: built as it opens, disposed as it closes. It takes no room where it's declared
native component Sheet() {
  prop children: View? = none
  /// shows the sheet while true; the user dismissing it writes false
  prop open: bool
  /// the heights it rests at ([]: large)
  prop detents: [Detent]
  prop grabber: bool
  /// covers the screen; the user can't swipe it away
  prop fullScreen: bool
  /// on a desktop, a dialog the user can move (a Mac's modal window, the web's panel) rather than a sheet attached to the window; phones ignore it
  prop movable: bool
  /// with movable, the user can also resize it; a movable sheet isn't resizable without it, as a desktop's dialogs aren't
  prop resizable: bool
  /// with movable, a press outside it dismisses it, as Escape does; a movable sheet takes no press outside without it
  prop dismissOutside: bool
  event change(open: bool)
  /// the user dismissed it
  event dismiss
}

/// an alert while open: its block's Buttons are its buttons (their title, icon, role and disabled; a cancel one's press runs as it's dismissed too), its TextFields its fields (placeholder, bind text, secure, keyboard, contentType). It takes no room where it's declared; with no Button, it has an OK
native component Alert(title: string) {
  prop children: View? = none
  /// shows the alert while true; choosing a button, or the user dismissing it, writes false
  prop open: bool
  /// under the title
  prop message: string
  /// an action sheet: a list of choices from the bottom of the screen (a popover on an iPad), its fields left out
  prop actionSheet: bool
  event change(open: bool)
  /// the user dismissed it without choosing a button (a tap outside, Android's back)
  event dismiss
}

/// content in a bubble pointing at its children while open (UIPopoverPresentationController, a PopupWindow, NSPopover)
native component Popover() {
  prop children: View? = none
  /// shows the popover while true; a tap outside writes false
  prop open: bool
  /// how wide it may be (0: 320); it's as big as its content
  prop maxWidth: float
  event change(open: bool)
  /// the user dismissed it
  event dismiss
  /// what the popover shows: built as it opens, disposed as it closes
  prop content: View? = none
}

/// its children over the window, placed next to an anchor while open: a select's list, a menu, a tooltip, a dialog. Not the platform's popover: what shows is only what it holds, styled by the app (std/base's popups are made of it)
native component Overlay() {
  prop children: View? = none
  /// shows its children while true: built as it opens, disposed as it closes (a change in animate { } plays their transition)
  prop open: bool
  /// the view it's placed next to: none, in its window (a dialog, a drawer, a toast)
  prop anchor: Ref?
  /// the anchor's side it goes on (.bottom, .top, .start, .end), or .center: over it. Without an anchor, the window's
  prop side: Side
  /// where on that side: .start, .center (or .auto), .end; .stretch: as long as the anchor on that side
  prop align: Align
  /// the gap between it and the anchor
  prop offset: float
  /// moves it along the side, from where align puts it
  prop alignOffset: float
  /// goes to the opposite side when it doesn't fit on its own and fits better there
  prop flip: bool = true
  /// the least distance it keeps from the window's edges (inside the safe area): it's moved along its side, and made no bigger than the room left
  prop edgeGap: float = 8
  /// at least as wide as the anchor (a select's list)
  prop matchWidth: bool
  /// presses reach only it while it's open (a backdrop's elsewhere), and screen readers see only it
  prop modal: bool
  /// what closes it: a press outside it (not on the anchor), Escape, Back (Android's, the web's Escape), the keyboard's focus leaving it and its anchor, the anchor scrolled or hidden out of view. Each writes open false and reports dismiss
  prop dismissOn: [DismissReason] = [.outsidePress, .escape, .back, .focusOut, .anchorHidden]
  event change(open: bool)
  /// the user dismissed it
  event dismiss(reason: DismissReason)
  /// where it went, once it's placed and each time that changes: the side after flipping (an arrow's side, a transition's direction), where the anchor's middle is along that side, the room it has
  event place(placed: Placed)
  /// what covers its window behind it while it's open (a dialog's dimming): as big as the window, built and disposed with the children
  prop backdrop: View? = none
}

/// shows a menu of actions when its children are tapped (UIMenu, PopupMenu). In a MenuBar, one of its menus: its children are MenuItems
native component Menu(title: string = "") {
  prop children: View? = none
  /// the menu's actions
  prop actions: [Action]
  /// a context menu: shown on a long press (a right click on a desktop) rather than a tap
  prop longPress: bool
}

/// destinations in a sidebar and the chosen one's screens beside it, as a Stack (UISplitViewController; Material's navigation drawer): its children are Destinations, or Sidebars of them
native component Split(title: string = "") {
  prop children: View? = none
  /// the chosen destination's index: the user's choice writes it
  prop selected: int
  event change(index: int)
}

/// a place a Split's sidebar leads to: its content is its first screen, built when it's chosen
native component Destination(title: string) {
  prop children: View? = none
  prop icon: string
  prop badge: string
  /// the sidebar section it's in: destinations next to each other with the same section are one
  prop section: string
}

/// a section of a Split's sidebar: its children are Destinations, under its title (a Destination's own section, if it gives one, wins)
native component Sidebar(title: string) {
  prop children: View? = none
}

/// a desktop window of its own while open (a window in the page on the web; phones have none): its content is built as it opens, disposed as it closes. The app block's Window is the main window: its keys are the main window's
native component Window() {
  prop children: View? = none
  /// the window is open while true; the user closing it writes false. The app block's Window, the main window, shows unless it's false
  prop open: bool
  /// its title bar's ("": the app's name)
  prop title: string
  /// its content's size as it opens, in points (0: the platform's, 800 by 600)
  prop width: float
  prop height: float
  /// the least the user can make it (0: the platform's)
  prop minWidth: float
  prop minHeight: float
  /// the most the user can make it (0: no most)
  prop maxWidth: float
  prop maxHeight: float
  /// its frame's top left on the screen, in points from the main display's (both 0: cascaded from the window in use, or centered with center)
  prop x: float
  prop y: float
  /// opens centered on its display
  prop center: bool
  /// the user can resize it
  prop resizable: bool = true
  prop minimizable: bool = true
  prop maximizable: bool = true
  /// it has a close button
  prop closable: bool = true
  /// above other apps' windows (not under Wayland)
  prop alwaysOnTop: bool
  /// opens without showing: its content is built and laid out, and w.show() shows it ready
  prop hidden: bool
  /// left out of the taskbar (Windows) and the Window menu (macOS)
  prop skipTaskbar: bool
  /// what's behind the window shows where the content draws nothing (macOS, Linux with a compositor)
  prop transparent: bool
  /// opens maximized
  prop maximized: bool
  /// opens in full screen
  prop fullScreen: bool
  /// .hidden: the content goes under the title bar, the window's buttons over it (environment().safeTop is the bar's height)
  prop titleBar: TitleBar
  /// fills the window behind its content (none: the platform's)
  prop background: Color
  /// belongs to the window it's declared in: stays above it, closes with it
  prop child: bool
  /// a child that blocks the window it's declared in while it's open (on a Mac, a sheet of it)
  prop modal: bool
  /// a launcher's or a palette's window: frameless, above every app's windows, out of the taskbar, taking the keyboard without bringing the app to the front; Escape and a click elsewhere close it (on closeRequest: hide it instead)
  prop panel: bool
  /// a frameless window hanging from an anchor (a tray icon: platform/tray's anchor(id); or a rectangle of the window it's declared in), closed as it loses the keyboard
  prop flyout: Flyout?
  /// sized to its content, within its least and most size, following it as it changes
  prop fitContent: bool
  /// the mouse goes through it to what's behind (an overlay's, a HUD's)
  prop clickThrough: bool
  /// shows the app's MenuBar as the main window does (Windows' menu bar, Linux's main menu; a Mac's is the app's)
  prop menuBar: bool
  /// where the platform remembers where the user left it, across launches (the main window's: "main" when it's empty)
  prop stateKey: string
  /// its document has unsaved changes
  prop edited: bool
  /// the path of the file it shows
  prop file: string
  event change(open: bool)
  /// the user closed it
  event close
  /// the user asked to close it: it stays open until open is false, or window.close()
  event closeRequest
}

/// shows its routes' screens from the address the app is at: its children are Routes. Router(initial: "/inbox") { … }
native component Router(initial: string = "/") {
  prop children: View? = none
}

/// maps a path to a screen, or holds routes: Route("/inbox", layout: .stack, title: "Inbox") { Inbox; Thread; Route(":id/reply", sheet: true) { p => Reply(id: p.get("id")) } }. Its block holds its child Routes, its screen (p => View, built with its Params), or routed screens named alone (screen Thread(id: int) at ":id"), a Route of their pattern each
native component Route(path: string = "", layout: RouteLayout = .group, title: string = "", icon: string = "", badge: string = "", initial: string = "", redirect: string = "", sheet: bool = false, detents: [Detent] = [], grabber: bool = false, fullScreen: bool = false, guard: (fn(string) -> string)? = none) {
  prop children: View? = none
}

/// an error boundary: an error its content doesn't catch shows on error's views
native component Boundary() {
  prop children: View? = none
  /// what shows instead when building its content, or an effect or handler in it, fails; reset builds it again
  event error(error: Error, reset: fn())
}

/// a row of dots, one per page, the current one highlighted (UIPageControl)
native component PageControl(count: int) {
  prop page: int
  event change(page: int)
}

/// the app's menus (macOS's menu bar; Windows' and Linux's in the main window), with their keyboard shortcuts, beside the platform's own: its children are Menus. While several show, the last one's are the app's; when it goes, the one before's. Phones ignore it
native component MenuBar() {
  prop children: View? = none
}

/// an item of a MenuBar's Menu: MenuItems in it make it a submenu
native component MenuItem(title: string) {
  prop children: View? = none
  /// chooses it from the keyboard, in every window of the app
  prop shortcut: Shortcut?
  /// .destructive draws it red; .quit, .close and .openRecent are the platform's own items
  prop role: MenuRole
  prop disabled: bool
  /// a check mark beside it
  prop checked: bool
  /// the user chose it (a click, its shortcut)
  event press
}

/// a line between a menu's groups of items
native component MenuSeparator() {}

/// keeps the window it's in open while when is true, asking the app first (unsaved changes) when the user closes it
native component WindowCloseGuard() {
  /// it asks while true
  prop when: bool = true
  /// the user asked to close the window it's in: the window stays open (window.close() closes it)
  event closeRequest
}

/// keys of the window it's in while it shows, whatever has the keyboard's focus: the ones no view takes (the last WindowKeys' win)
native component WindowKeys() {
  /// what they run
  prop keys: [Shortcut]
}
