// DialogUserSelect is a web e2e's app (e2e/dialog_user_select_test.go): a
// sheet with a title, a Close button and a selectable text, for a
// dialog's own text and controls (not selectable).

component Dialogs {
  state open = false

  Column {
    padding: 12
    gap: 6
    Text("status: ready")
    Button("Open") { on press { open = true } }
    Sheet {
      bind open: open
      Column {
        padding: 12
        gap: 6
        Row {
          gap: 12
          Text("Sheet title") { grow: 1 }
          Button("Close") { on press { open = false } }
        }
        Text("First line of the body\nSecond line of the body") { selectable: true }
      }
    }
  }
}

app { Dialogs() }
