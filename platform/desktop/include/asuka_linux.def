// asuka_linux.def: the functions of GLib, GObject, GIO, cairo, Pango,
// GDK, GSK, GTK 4, libadwaita and the optional libraries (WebKitGTK,
// GStreamer, Xlib, fontconfig, libepoxy, libsecret, libsoup, Evolution
// Data Server) that the Linux host and native packages' Linux C call, one
// list: SYM(library, result, name, parameters), resolved with dlsym
// (src/linux_syms.c). The types are GTK's names (asuka_linux.h declares
// them). A package's C calls them as G(name); the host by their names
// (platform/linux/src/gtk.h).

// asuka_linux.def: the functions of the system's libraries the host calls,
// SYM(library, result, name, parameters), resolved with dlsym (syms.c).
// The types are GTK's names (gtk.h declares them), so check_syms.c can
// compare these with the real headers.

// ---- GLib ----
SYM(GLIB, void, g_free, (gpointer mem))
SYM(GLIB, gchar *, g_strdup_printf, (const gchar *format, ...))
SYM(GLIB, const gchar *, g_get_home_dir, (void))
