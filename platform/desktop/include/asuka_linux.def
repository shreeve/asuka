SYM(GLIB, GMainContext *, g_main_context_default, (void))
SYM(GLIB, gboolean, g_main_context_is_owner, (GMainContext *context))
SYM(GLIB, void, g_set_application_name, (const gchar *application_name))
SYM(GLIB, GDateTime *, g_date_time_new_local, (gint year, gint month, gint day, gint hour, gint minute, gdouble seconds))
SYM(GLIB, GDateTime *, g_date_time_new_from_unix_local, (gint64 t))
SYM(GLIB, void, g_date_time_unref, (GDateTime *datetime))
SYM(GLIB, gchar *, g_date_time_format, (GDateTime *datetime, const gchar *format))
