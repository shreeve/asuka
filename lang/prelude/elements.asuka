/// a text: it wraps, unless lines limits it
native component Text(text: string) {
  /// the text can be selected and copied
  prop selectable: bool
}

/// the platform's button
native component Button(title: string) {
  /// how the platform draws it
  prop variant: ButtonVariant
  /// a symbol before the title (see Symbol); with no title, the icon alone
  prop icon: string
  /// actions shown when it's tapped, instead of press
  prop menu: [Action]
  /// goes to this route when it's pressed, after press (the Router around it navigates there): an href, or a routed screen's call (href: Thread(id: 7))
  prop href: string
  /// in an Alert or a Screen's bars, what it does, which the platform draws it by: .cancel, .destructive (red)
  prop role: ActionRole
  event press
}

/// a text field: a line, or lines with multiline
native component TextField() {
  /// its text: typing writes it, and writing it replaces what the field shows
  prop text: string
  prop placeholder: string
  prop keyboard: Keyboard
  prop returnKey: ReturnKey
  /// a password's: its characters hidden
  prop secure: bool
  prop autocapitalize: Autocapitalize
  prop autocorrect: Autocorrect
  /// what it holds, for the system's AutoFill: username, password, newPassword, oneTimeCode, email, ...
  prop contentType: string
  /// lines of text: return is a new line, not submit, and it grows with its text up to lines lines
  prop multiline: bool
  /// without the platform's border, background and inset: its text alone
  prop plain: bool
  /// takes the keyboard as it shows
  prop autofocus: bool
  /// the cursor or the selected text, as byte offsets into text: the user's moves write it, and writing it moves them
  prop selection: TextRange
  /// makes it a text area of styled text: bold, italic, underline, strikethrough, monospaced, links. The user's typing and formatting write it; writing it replaces the text, and text follows its plain text. Inline components are left out. It makes the field multiline
  prop rich: [Span]
  /// whether it has the keyboard: the user's tapping in and out writes it, and writing it takes the keyboard or gives it up
  prop focused: bool
  /// the MIME types (patterns, as "image/*") of what on paste takes instead of the text: pasted, or put in by the keyboard (a GIF keyboard's images)
  prop pasteTypes: [string]
  event change(text: string)
  /// return pressed (not in a multiline field)
  event submit
  event focus
  event blur
  event select(selection: TextRange)
  /// it took the keyboard, or gave it up
  event focusChange(focused: bool)
  event richChange(rich: [Span])
  /// the styles where the cursor is, or that all the selection has, as they change: a toolbar's buttons show them
  event formats(formats: TextFormats)
  /// what was pasted of pasteTypes: images and files are the app's own copies, in its caches
  event paste(items: [SharedItem])
  /// a bar on top of the keyboard while the field is focused (a count and Done, formatting buttons): as wide as the window, as tall as its content, built and gone with the field. Desktops don't show it
  prop accessory: View? = none
}

/// a switch, or a checkbox
native component Toggle() {
  prop on: bool
  /// what screen readers call it (the text beside it is the app's)
  prop title: string
  /// a checkbox rather than a switch
  prop checkbox: bool
  event change(on: bool)
}

/// picks a value in a range
native component Slider() {
  prop value: float
  prop min: float = 0
  prop max: float = 1
  event change(value: float)
}

/// steps a value with minus and plus buttons; show the value beside it
native component Stepper() {
  prop value: float
  prop min: float = 0
  prop max: float = 100
  prop step: float = 1
  event change(value: float)
}

/// one of a few options side by side
native component Segmented(segments: [string]) {
  prop selected: int
  event change(index: int)
}

/// picks one of many options from a menu, showing the chosen one
native component Picker(items: [string]) {
  /// the chosen item's index; out of range: none, and it shows its prompt
  prop selected: int = -1
  /// what it picks: shown while none is chosen (Android's floating label), and read by screen readers
  prop prompt: string
  event change(index: int)
}

/// one of many options on a spinning wheel (UIPickerView; Android's NumberPicker)
native component Wheel(items: [string]) {
  /// the item turned to
  prop selected: int
  event change(index: int)
}

/// a swatch of a color that opens the platform's picker (UIColorWell; a Material dialog of a palette on Android)
native component ColorPicker() {
  /// the color chosen
  prop value: Color
  /// the user can choose an opacity too
  prop alpha: bool
  /// the picker's title
  prop title: string
  event change(color: Color)
}

/// a date or a time, chosen the platform's way (UIDatePicker; Material's date and time pickers), in the device's time zone and format
native component DatePicker() {
  /// the instant chosen, in milliseconds since 1970 (std/time's time.Picker binds a Time)
  prop value: int
  /// a date, a time of day, or both
  prop mode: DateMode
  /// the earliest choice, in milliseconds since 1970 (0: none)
  prop min: int
  /// the latest choice (0: none)
  prop max: int
  /// iOS: the calendar and the time shown in place, not from a button
  prop inline: bool
  event change(value: int)
}

/// a progress bar; its color is its fill
native component Progress() {
  /// done, from 0 to 1; none: under way, how far unknown
  prop value: float?
}

/// circular progress; its color is its fill
native component ProgressRing() {
  /// done, from 0 to 1; none: the platform's spinning indicator
  prop value: float?
}

/// a spinner
native component Activity() {}

/// a symbol (an SF Symbol, the Material Symbol for it), sized as text of its font and colored with its color
native component Symbol(name: string) {}

/// a picture the host loads; without a size it takes its natural one, no wider than its room, and keeps its aspect ratio when one side is set
